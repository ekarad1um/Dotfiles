{
    "workbench.startupEditor": "newUntitledFile",
    "files.autoSave": "onFocusChange",
    "editor.smoothScrolling": true,
    "editor.stablePeek": true,
    "editor.tabCompletion": "on",
    "files.insertFinalNewline": true,
    "search.smartCase": true,
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.suggest.localityBonus": true,
    "files.simpleDialog.enable": false,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "workbench.commandPalette.preserveInput": true,
    "workbench.list.horizontalScrolling": true,
    "workbench.quickOpen.preserveInput": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.settings.useSplitJSON": true,
    "window.autoDetectColorScheme": true,
    "problems.showCurrentInStatus": true,
    "editor.find.autoFindInSelection": "multiline",
    "terminal.integrated.copyOnSelection": true,
    "html.format.indentInnerHtml": true,
    "merge-conflict.autoNavigateNextConflict.enabled": true,
    "files.autoGuessEncoding": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "debug.onTaskErrors": "showErrors",
    "files.associations": {
        "*.ejs": "html"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "settingsSync.ignoredExtensions": [],
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace",
        "editor.semanticHighlighting.enabled": true
    },
    "editor.inlineSuggest.enabled": true,
    "workbench.editor.wrapTabs": true,
    "hexeditor.columnWidth": 32,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "editor.suggest.preview": true,
    "telemetry.telemetryLevel": "off",
    "extensions.supportUntrustedWorkspaces": {},
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "editor.minimap.renderCharacters": false,
    "terminal.integrated.persistentSessionScrollback": 10000,
    "editor.stickyScroll.enabled": true,
    "markdown.occurrencesHighlight.enabled": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "editor.experimental.asyncTokenization": true,
    "editor.hover.delay": 10,
    "editor.linkedEditing": true,
    "editor.quickSuggestions": {
        "comments": "on"
    },
    "workbench.list.smoothScrolling": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.experimentalWhitespaceRendering": "font",
    "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": true,
    "diffEditor.experimental.showMoves": true,
    "multiDiffEditor.experimental.enabled": false,
    "workbench.editor.highlightModifiedTabs": true,
    "search.seedOnFocus": true,
    "search.seedWithNearestWord": true,
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.scrollbar.vertical": "hidden",
    "terminal.integrated.smoothScrolling": true,
    "notebook.output.scrolling": true,
    "editor.minimap.showSlider": "always",
    "markdown.preview.typographer": true,
    "terminal.integrated.enableImages": true,
    "workbench.editor.scrollToSwitchTabs": true,
    "editor.codeActionsOnSave": {},
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.excludeDirty": true,
    "workbench.editor.limit.perEditorGroup": true,
    "search.quickAccess.preserveInput": true,
    "search.searchEditor.focusResultsOnSearch": true,
    "debug.showSubSessionsInToolBar": true,
    "debug.showVariableTypes": true,
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.terminal.clearBeforeReusing": true,
    "terminal.integrated.scrollback": 10000,
    "ipynb.experimental.serialization": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "editor.inlineSuggest.syntaxHighlightingEnabled": true,
    "editor.stickyTabStops": true,
    "workbench.fontAliasing": "antialiased",
    "explorer.incrementalNaming": "smart",
    "search.defaultViewMode": "tree",
    "scm.defaultViewMode": "tree",
    "terminal.integrated.fontLigatures.enabled": true,
    "chat.agent.enabled": true,
    "mediaPreview.video.autoPlay": true,
    "mediaPreview.video.loop": true,
    "markdown.updateLinksOnFileMove.enabled": "never",
    "settingsSync.ignoredSettings": [
        "-python.locator"
    ],
    "workbench.tips.enabled": false,
    "diffEditor.codeLens": true,
    "workbench.hover.delay": 10,
    "workbench.editor.splitInGroupLayout": "vertical",
    "telemetry.feedback.enabled": false,
    "files.readonlyFromPermissions": true,
    "workbench.remoteIndicator.showExtensionRecommendations": false,
