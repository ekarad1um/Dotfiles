    "notebook.inlineValues": "auto",
    "editor.selectionHighlightMultiline": true,
    "editor.wrappingStrategy": "advanced",
    "terminal.integrated.gpuAcceleration": "on",
    "chat.mcp.autostart": "onlyNew",
    "rust-analyzer.initializeStopped": true,
    "rust-analyzer.linkedProjects": [],
    "rust-analyzer.showSyntaxTree": true,
    "search.quickOpen.includeSymbols": true,
    "remote.SSH.remoteServerListenOnSocket": true,
    "terminal.integrated.focusAfterRun": "terminal",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.suggest.cdPath": "relative",
    "github.copilot.nextEditSuggestions.enabled": true,
    "telemetry.editStats.enabled": false,
    "workbench.editor.defaultBinaryEditor": "hexEditor.hexedit",
    "search.searchEditor.reusePriorSearchConfiguration": true,
    "extensions.experimental.deferredStartupFinishedActivation": true,
    "task.quickOpen.skip": true,
    "chat.math.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "shellscript": true
    },
    "git.confirmSync": false,
    "terminal.integrated.allowChords": false,
    "terminal.integrated.macOptionIsMeta": true,
    "editor.autoIndentOnPaste": true,
    "editor.experimental.preferTreeSitter.regex": true,
    "editor.inertialScroll": true,
    "editor.unfoldOnClickAfterEndOfLine": true,
    "workbench.panel.showLabels": false,
    "workbench.editor.limit.value": 9,
    "window.density.editorTabHeight": "compact",
    "workbench.activityBar.location": "top",
    "search.collapseResults": "auto",
    "search.showLineNumbers": true,
    "extensions.ignoreRecommendations": true,
    "remote.restoreForwardedPorts": false,
    "notebook.cellToolbarVisibility": "hover",
    "notebook.experimental.remoteSave": true,
    "notebook.lineNumbers": "on",
    "notebook.variablesView": true,
    "http.proxySupport": "fallback",
    "http.experimental.systemCertificatesV2": true,
    "git.autofetch": true,
    "git.supportCancellation": true,
    "github.copilot.chat.alternateGeminiModelFPrompt.enabled": true,
    "github.copilot.chat.alternateGptPrompt.enabled": true,
    "svelte.enable-ts-plugin": true,
    "svelte.ask-to-enable-ts-plugin": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "terminal.integrated.suggest.enabled": true,
    "git.enableSmartCommit": true,
    "workbench.editor.tabActionCloseVisibility": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "explorer.fileNesting.enabled": true,
    "chat.editing.confirmEditRequestRetry": false,
    "chat.plugins.marketplaces": [
        "github/copilot-plugins",
        "github/awesome-copilot",
        "https://github.com/ChromeDevTools/chrome-devtools-mcp"
    ],
    "chat.editing.confirmEditRequestRemoval": false,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://docs.rs": true,
        "https://www.w3.org": {
            "approveRequest": false,
            "approveResponse": true
        }
    },
    "github.copilot.nextEditSuggestions.eagerness": "auto",
    "diffEditor.maxComputationTime": 0,
    "chat.agent.maxRequests": 100,
    "diffEditor.ignoreTrimWhitespace": true,
    "terminal.integrated.initialHint": false,
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.experimental.modernUI": true
}
